  "local_changes": [
    "server/efmi_mcp/tools.py accepts an explicit Session for AP process selection.",
    "server/efmi_mcp/tools.py decodes zero-stride vertex streams as one shared attribute record.",
    "server/efmi_mcp/probe_client.py closes the connection on EOF so AP can reconnect after a game restart.",
    "server/efmi_mcp/tools.py exports shared zero-stride vertex data, reports per-buffer exactness and handles indirect base vertices; whole-buffer hashes are not compared to region CRCs.",
    "server/efmi_mcp/parity.py compares whole-buffer index hashes as well as region hashes.",
    "server/efmi_mcp/mods_toggle.py follows explicit package INI includes to find mod-state notification texts.",
    "probe/src/common.h versions the local probe as 0.1.18-apmi.1.",
    "probe/src/reload.cpp and server/efmi_mcp/xxmi_install.py recognize the APMI Core F11 binding."
