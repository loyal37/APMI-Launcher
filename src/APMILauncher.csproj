<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <AssemblyName>APMI Launcher</AssemblyName>
    <RootNamespace>ApmiLauncher</RootNamespace>
    <Version>0.1.0</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AllowedReferenceRelatedFileExtensions>.none</AllowedReferenceRelatedFileExtensions>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3537.50" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="ui\index.html" LogicalName="ApmiLauncher.ui.index.html" />
    <EmbeddedResource Include="ui\styles.css" LogicalName="ApmiLauncher.ui.styles.css" />
    <EmbeddedResource Include="ui\app.js" LogicalName="ApmiLauncher.ui.app.js" />
  </ItemGroup>
</Project>
